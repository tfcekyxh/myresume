{
  "name": "mymenu",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:client": "bun run --filter client dev",
    "dev:server": "bun run --filter server dev",
    "build": "bun run --filter client build",
    "start": "bun run --filter server start",
    "db:generate": "bun run --filter server db:generate",
    "db:migrate": "bun run --filter server db:migrate",
    "db:seed": "bun run --filter server db:seed",
    "db:studio": "bun run --filter server db:studio",
    "backup:mail": "bun run --filter server backup:mail",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "demo": "playwright test --config demo/playwright.config.ts",
    "demo:seed": "bun demo/scripts/seed-cli.ts",
    "demo:convert": "bun demo/scripts/convert.ts",
    "demo:all": "bun run demo:seed && bun run demo && bun run demo:convert"
  },
  "devDependencies": {
    "@mymenu/shared": "workspace:*",
    "@playwright/test": "^1.63.0",
    "dotenv": "^18.0.0"
  }
}
