# PostgreSQL 连接串（云数据库需按服务商要求追加 sslmode）
DATABASE_URL="postgresql://user:password@host:5432/mymenu?schema=public"

# express-session 签名密钥，随便一串足够长的随机字符
SESSION_SECRET=""

# 服务端端口
PORT=3000

# 简历导入解析用的大模型（OpenAI 兼容 Chat Completions 接口）
# 默认智谱 GLM-4-Flash（免费额度）：https://open.bigmodel.cn/
# 留空 LLM_API_KEY 时编辑页的「导入简历」功能不可用，其余功能不受影响
LLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
LLM_API_KEY=""
LLM_MODEL="glm-4-flash"
