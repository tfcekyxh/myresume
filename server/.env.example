# SQLite 库文件路径。留空则用默认值 server/data/app.sqlite。
# 单机部署到挂载卷时改成卷内路径，例如 /data/app.sqlite
SQLITE_PATH=""

# express-session 签名密钥，随便一串足够长的随机字符
SESSION_SECRET=""

# 服务端端口
PORT=3000

# 数据备份页（导出 / 导入整库）的管理员用户名。
# 留空表示没有人有权限，两个备份接口一律返回 403。
ADMIN_USERNAME=""

# 简历导入解析用的大模型（OpenAI 兼容 Chat Completions 接口）
# 默认智谱 GLM-4-Flash（免费额度）：https://open.bigmodel.cn/
# 留空 LLM_API_KEY 时编辑页的「导入简历」功能不可用，其余功能不受影响
LLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
LLM_API_KEY=""
LLM_MODEL="glm-4-flash"

# 邮件发送通道：每月自动备份邮件 + 版本列表的「发送到邮箱」，两处共用。
# 只配 MAIL_API_KEY 即可，其余留空用默认值；不配 Key 时这两处功能都关闭。
# 默认走 Resend 的 HTTP 接口（请求体与它兼容，换成别的服务商时改 MAIL_API_URL）。
MAIL_API_URL="https://api.resend.com/emails"
MAIL_API_KEY=""
# 发件地址：Resend 未验证自有域名时用 onboarding@resend.dev，且只能发给注册邮箱
MAIL_FROM="onboarding@resend.dev"
# 收件人，可逗号分隔多个。**必填**：留空即视为未配置，两处发信功能一起关闭。
# 真实地址只写在这里（本文件不入库），不要在源码或文档里写具体邮箱。
MAIL_TO=""
