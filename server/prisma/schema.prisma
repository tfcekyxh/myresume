generator client {
  provider = "prisma-client-js"
  // 生成到源码目录，而不是默认的 node_modules/.prisma。
  // 默认位置依赖 @prisma/client 的 postinstall 生成，而构建平台的 install 阶段
  // 往往只放 package.json 与锁文件、拿不到 schema，且 node_modules 可能在
  // 构建后被重建，导致运行时找不到 client。放进源码目录则随代码一起进镜像。
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  resumes Resume[]
}

model Resume {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String          @default("我的简历")
  data      Json            @default("{}")
  photoId   String?
  photo     Photo?          @relation("CurrentPhoto", fields: [photoId], references: [id])
  photos    Photo[]         @relation("ResumePhotos")
  versions  ResumeVersion[]
  updatedAt DateTime        @updatedAt
  /// 草稿最近一次被存档时的 updatedAt；比 updatedAt 旧即说明有未存档改动
  lastArchivedAt DateTime?

  @@index([userId])
}

model Photo {
  id        String          @id @default(uuid())
  resumeId  String
  resume    Resume          @relation("ResumePhotos", fields: [resumeId], references: [id], onDelete: Cascade)
  data      String
  createdAt DateTime         @default(now())

  currentFor Resume[]        @relation("CurrentPhoto")
  inVersions ResumeVersion[] @relation("VersionPhoto")

  @@index([resumeId])
}

model ResumeVersion {
  id        String   @id @default(uuid())
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  snapshot  Json
  photoId   String?
  photo     Photo?   @relation("VersionPhoto", fields: [photoId], references: [id])
  note      String?
  createdAt DateTime @default(now())

  @@index([resumeId])
}

/// 限流计数。key 形如 `login:ip:1.2.3.4`，windowStart 是窗口起点对齐后的时间。
/// 复合主键让「加一」能用一条 UPSERT 完成，多实例共享同一份计数。
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  /// 过期行清理按时间扫描
  @@index([windowStart])
}